# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key (sb_publishable_...) or legacy anon JWT
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret key — Project Settings → API → service_role (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed to access /admin (owner accounts)
ADMIN_ALLOWED_EMAILS=owner@example.com

# ── Cloudflare R2 (S3-compatible) ─────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=shakaron-media
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ── Optional — AI assistant ───────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
